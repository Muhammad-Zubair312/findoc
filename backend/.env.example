# =============================================================================
# FinDoc Intelligence — Backend Environment Variables
# Copy this to backend/.env and fill in your values
# =============================================================================

# ── LLM: Groq (FREE — no credit card required) ───────────────────────────────
# Sign up at: https://console.groq.com
# Click API Keys → Create API Key → paste the gsk_... key below
GROQ_API_KEY=your_groq_api_key_here          # starts with gsk_
LLM_BASE_URL=https://api.groq.com/openai/v1  # DO NOT change this
GROQ_CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  # generation — 500K tokens/day free tier
GROQ_FAST_MODEL=llama-3.1-8b-instant         # for routing, grading, tree navigation

# ── Embeddings (LOCAL — zero API cost, runs on your CPU) ─────────────────────
# No API key needed. Model downloads automatically on first startup (~90MB).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# ── Vector Store: Qdrant ─────────────────────────────────────────────────────
# LOCAL DEV: Docker runs Qdrant at localhost:6333, no API key needed
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=findoc_sections
# PRODUCTION: Get free cluster at https://cloud.qdrant.io (1GB free, no card)
# QDRANT_URL=https://xxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here

# ── Database: PostgreSQL ──────────────────────────────────────────────────────
# LOCAL DEV: Docker runs Postgres at localhost:5432
DATABASE_URL=postgresql+asyncpg://findoc:findoc_dev@localhost:5432/findoc
# PRODUCTION: Get free DB at https://neon.tech (512MB free, no card)
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/findoc

# ── Cache & Queue: Redis ──────────────────────────────────────────────────────
# LOCAL DEV: Docker runs Redis at localhost:6379
REDIS_URL=redis://localhost:6379/0
# PRODUCTION: Get free Redis at https://upstash.com (10k req/day free)
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST:6379

# ── File Storage ──────────────────────────────────────────────────────────────
# LOCAL DEV: files stored on disk in ./uploads folder (no cloud needed)
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=./uploads
# PRODUCTION: Cloudflare R2 (10GB free + 1M writes/month — no card required)
# USE_LOCAL_STORAGE=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=findoc-uploads

# ── SEC EDGAR ─────────────────────────────────────────────────────────────────
# Required to fetch 10-K filings from SEC. Use YOUR real name and email.
# No registration needed — SEC just requires identification.
SEC_EDGAR_USER_AGENT=Your Name youremail@gmail.com

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_32_char_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# ── LLM Observability: Langfuse (OPTIONAL — free cloud tier) ─────────────────
# Sign up at https://cloud.langfuse.com to see LLM traces and token usage
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# ── Error Tracking: Sentry (OPTIONAL — 5k errors/month free) ─────────────────
SENTRY_DSN=

# ── App Config ────────────────────────────────────────────────────────────────
ENV=dev
CORS_ORIGINS=["http://localhost:3000"]

# ── Rate limit tuning for Groq free tier ─────────────────────────────────────
# Groq free tier: 14,400 requests/day, 30 req/min per model
# These delays prevent hitting rate limits during document ingestion
INGEST_NODE_SUMMARY_DELAY_SECS=0.1
EVAL_DELAY_SECS=0.5
